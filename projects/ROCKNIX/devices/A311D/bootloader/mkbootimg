# Adapted for ROCKNIX A311D chain-boot (stock Amlogic U-Boot, Android boot image)
#
# The stock 2015.01 Amlogic U-Boot on this box cannot handle a
# zstd-compressed ramdisk in the Android boot image (black screen at
# bootm). Keep the ramdisk as an uncompressed newc cpio, matching
# EmuELEC/CoreELEC which boots fine on this hardware.

RAMDISK=${BUILD}/image/${1}.cpio

echo
echo "Using uncompressed ramdisk ${1}.cpio (stock U-Boot compatible)"
stat -c "  %s bytes  %n" ${RAMDISK}

LDFLAGS="" mkbootimg --kernel arch/${TARGET_KERNEL_ARCH}/boot/${KERNEL_TARGET} --ramdisk ${RAMDISK} \
  ${ANDROID_BOOTIMG_OPTIONS} --output arch/${TARGET_KERNEL_ARCH}/boot/boot.img
