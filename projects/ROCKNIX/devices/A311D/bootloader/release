SRCDIR="${INSTALL}/usr/share/bootloader"
DSTDIR="${RELEASE_DIR}/3rdparty/bootloader"

mkdir -p "${DSTDIR}/device_trees"
cp -a "${SRCDIR}"/* "${DSTDIR}/" 2>/dev/null || true
if [ -d "${SRCDIR}/device_trees" ]; then
  cp -a "${SRCDIR}/device_trees/"*.dtb "${DSTDIR}/device_trees/"
fi

# Stage-B: dtb.img is the verified 54,984-byte bootkit binary installed by
# the u-boot package; mkimage_aml_boot() mcopies it to /flash/dtb.img.
# Do NOT overwrite it with a locally compiled dtb - the local DTS output is
# a different (80,688 B) tree whose USB VBUS regulator bindings are not the
# ones validated on the board.
if [ ! -f "${DSTDIR}/dtb.img" ]; then
  echo "A311D: dtb.img was not installed from bootkit" >&2
  exit 1
fi
if ! cmp -s "${DSTDIR}/dtb.img" "${DSTDIR}/device_trees/meson-g12b-a311d-cainiao-cniot-core.dtb"; then
  echo "A311D: dtb.img and device_trees dtb differ (OTA cmp would fail)" >&2
  exit 1
fi
