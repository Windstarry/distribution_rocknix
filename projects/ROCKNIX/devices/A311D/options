################################################################################
# setup device defaults
################################################################################

  # The TARGET_CPU variable controls which processor should be targeted for
  # generated code.
    case ${TARGET_ARCH} in
      aarch64)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_KERNEL_PATCH_ARCH="aarch64"
        TARGET_CPU="cortex-a73.cortex-a53"
        TARGET_ARCH_FLAGS="+crc+fp+simd"
        TARGET_FEATURES="64bit"
        ;;
      arm)
        TARGET_KERNEL_ARCH="arm64"
        TARGET_KERNEL_PATCH_ARCH="aarch64"
        TARGET_CPU="cortex-a73.cortex-a53"
        TARGET_ARCH_FLAGS="+crc"
        TARGET_FPU="neon-fp-armv8"
        TARGET_FLOAT="hard"
        TARGET_FEATURES="32bit"
        ;;
    esac

    PARTITION_TABLE="msdos"
    HW_CPU="Amlogic A311D"

  # Kernel target (Android boot image for the stock Amlogic U-Boot chain)
    KERNEL_TARGET="Image.lzo"
    KERNEL_NAME="kernel.img"
    BUILD_ANDROID_BOOTIMG="yes"
  # Load addresses measured on the target device kernel.img header:
  #   kernel_addr=0x01080000  ramdisk_addr=0x01000000
  # The stock Amlogic U-Boot loads kernel.img at its loadaddr (0x01080000),
  # so the offsets below must match that instead of the S905 defaults.
    ANDROID_BOOTIMG_OPTIONS="--base 0x0 --kernel_offset 0x01080000 --ramdisk_offset 0x01000000"

  # Kernel extra targets to build
    KERNEL_MAKE_EXTRACMD=" dtbs"

  # Kernel cmdline
    EXTRA_CMDLINE="quiet console=ttyAML0,115200n8 console=tty0 systemd.debug_shell=ttyAML0"

  # Bootloader to use (syslinux / u-boot)
    BOOTLOADER="u-boot"

  # No U-Boot firmware needed: the boot chain is the stock Amlogic U-Boot
  # (aml_autoscript/cfgload + Android boot image), nothing is written to the
  # boot medium.
    UBOOT_FIRMWARE=""

  # Mali GPU family for the proprietary userspace driver (Mali-G52 / Bifrost)
    MALI_FAMILY="meson"
  # Keep panfrost in the kernel so both GPU stacks can be selected at runtime
    GRAPHIC_DRIVERS="panfrost"

  # For maximum cross compatbility
    PREFER_GLES="yes"

  # Vulkan implementation to use (vulkan-loader / no)
    VULKAN="vulkan-loader"

  # VULKAN_SUPPORT
    VULKAN_SUPPORT="yes"

  # Displayserver to use (wl / x11 / no)
    DISPLAYSERVER="wl"

  # Windowmanager to use (weston / swaywm-env / no)
    WINDOWMANAGER="swaywm-env"

  # Additional drivers to install:
  # for a list of additional drivers see packages/linux-drivers
  # Space separated list is supported,
  # e.g. ADDITIONAL_DRIVERS="DRIVER1 DRIVER2"
    ADDITIONAL_DRIVERS="RTW88 mali-bifrost"

  # Additional Firmware to use ( )
  # Space separated list is supported,
  # e.g. FIRMWARE=""
    FIRMWARE=""

  # Additional packages to install
    ADDITIONAL_PACKAGES="libmali"

  # Debug tty path
    DEBUG_TTY="/dev/ttyAML0"

  # Chain-boot has no extlinux.conf, so out-of-tree dtb overlays are not used
    ROCKNIX_DEVICE_TREE_OVERLAYS=""

  # ROCKNIX joypad driver (not needed for TV box platforms)
    ROCKNIX_JOYPAD="no"

  # ZRAM Algorithm
    ZRAM_COMPRESSION_ALGO="zstd"

  # ZRAM Size
    ZRAM_SWAP_SIZE="Auto"

  # Disk Swap
    SWAP_FILE_SIZE="0"
